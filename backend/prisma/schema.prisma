// AI Platform Database Schema

generator client {
  provider = "prisma-client-py"
  interface = "asyncio"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  projects      Project[]
  workflows     Workflow[]
  exports       ExportedProject[]
  activities    Activity[]
  integrations  Integration[]
  apiKeys       ApiKey[]

  @@index([email])
  @@index([username])
}

enum Role {
  ADMIN
  USER
  VIEWER
}

// Projects
model Project {
  id              String    @id @default(uuid())
  name            String
  description     String?
  type            ProjectType
  config          Json      // model, temperature, etc.
  status          ProjectStatus @default(ACTIVE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  workflows       Workflow[]
  exports         ExportedProject[]
  files           ProjectFile[]

  @@index([userId])
  @@index([status])
}

enum ProjectType {
  WORKFLOW
  FULLSTACK_APP
  BOT
  API
  WEB_APP
  AUTOMATION
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DEPLOYED
  FAILED
}

// Workflows
model Workflow {
  id              String    @id @default(uuid())
  name            String
  description     String?
  definition      Json      // workflow nodes, edges, config
  version         Int       @default(1)
  status          WorkflowStatus @default(DRAFT)
  templateId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId          String
  user            User      @relation(fields: [userId], references: [id])

  template        Template? @relation(fields: [templateId], references: [id])

  executions      WorkflowExecution[]

  @@index([projectId])
  @@index([userId])
  @@index([status])
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

// Workflow Executions
model WorkflowExecution {
  id              String    @id @default(uuid())
  status          ExecutionStatus
  input           Json?
  output          Json?
  logs            Json[]
  metrics         Json?     // tokens, cost, duration
  errorMessage    String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  workflowId      String
  workflow        Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  steps           ExecutionStep[]

  @@index([workflowId])
  @@index([status])
  @@index([startedAt])
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// Execution Steps
model ExecutionStep {
  id              String    @id @default(uuid())
  stepName        String
  stepType        String    // agent, condition, loop, etc.
  status          ExecutionStatus
  input           Json?
  output          Json?
  logs            String[]
  errorMessage    String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  executionId     String
  execution       WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([status])
}

// Templates
model Template {
  id              String    @id @default(uuid())
  name            String
  description     String
  category        TemplateCategory
  definition      Json
  thumbnail       String?
  rating          Float     @default(0)
  usageCount      Int       @default(0)
  isPublic        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workflows       Workflow[]

  @@index([category])
  @@index([isPublic])
  @@index([rating])
}

enum TemplateCategory {
  BOT
  API
  WEB_APP
  AUTOMATION
  DATA_PROCESSING
  INTEGRATION
}

// Integrations
model Integration {
  id              String    @id @default(uuid())
  name            String
  type            IntegrationType
  config          Json
  credentials     Json      // encrypted
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isActive])
}

enum IntegrationType {
  API
  DATABASE
  MESSAGING
  STORAGE
  AI_SERVICE
  CORE
}

// Exported Projects
model ExportedProject {
  id              String    @id @default(uuid())
  name            String
  type            ProjectType
  format          ExportFormat
  fileUrl         String
  fileSize        Int
  deploymentUrl   String?
  deploymentStatus DeploymentStatus?
  createdAt       DateTime  @default(now())

  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId          String
  user            User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

enum ExportFormat {
  ZIP
  DOCKER
  KUBERNETES
  TELEGRAM_BOT
  WEB_APP
}

enum DeploymentStatus {
  PENDING
  DEPLOYING
  DEPLOYED
  FAILED
}

// Project Files (for DUO IDE)
model ProjectFile {
  id              String    @id @default(uuid())
  path            String
  content         String
  language        String?
  size            Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
}

// Activity Logs
model Activity {
  id              String    @id @default(uuid())
  action          String
  entityType      String
  entityId        String
  metadata        Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([entityType, entityId])
}

// API Keys
model ApiKey {
  id              String    @id @default(uuid())
  name            String
  key             String    @unique
  service         ApiService
  isActive        Boolean   @default(true)
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([service])
  @@index([isActive])
}

enum ApiService {
  OPENAI
  ANTHROPIC
  INTERNAL
  TELEGRAM
  STRIPE
}

// Code Repositories (for context and RAG)
model CodeRepository {
  id              String    @id @default(uuid())
  url             String
  branch          String    @default("main")
  localPath       String
  lastSyncAt      DateTime?
  status          RepoStatus @default(PENDING)
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  embeddings      CodeEmbedding[]

  @@index([status])
}

enum RepoStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
}

// Code Embeddings for RAG
model CodeEmbedding {
  id              String    @id @default(uuid())
  filePath        String
  chunkIndex      Int
  content         String
  embedding       Json      // vector embedding
  metadata        Json?
  createdAt       DateTime  @default(now())

  repositoryId    String
  repository      CodeRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, filePath, chunkIndex])
  @@index([repositoryId])
}
